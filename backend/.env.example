# ----- Backend environment variables -----
# Local dev: copy this file to ".env" and fill values.
# Production (Vercel/Render): set these in the host's dashboard, NOT in a committed file.

PORT=5000

# MongoDB Atlas connection string. Include the database name before the "?".
# Example: mongodb+srv://USER:PASSWORD@wert.zfawce4.mongodb.net/wert?retryWrites=true&w=majority&appName=WERT
MONGODB_URI=
# Optional: overrides the db name in the URI (defaults to "wert")
MONGODB_DB=wert

# Use a long random string in production (e.g. `openssl rand -base64 48`)
JWT_SECRET=
JWT_EXPIRE=7d

# The exact frontend origin, NO trailing slash
FRONTEND_URL = https://www.hausverwaltungwert.de

# Required to use /api/seed-admin in production: visit /api/seed-admin?secret=THIS_VALUE
SEED_SECRET=
# Optional starting admin password for seeding
SEED_ADMIN_PASSWORD=

# Email is currently unused by the code; leave blank unless you wire up nodemailer.
EMAIL_HOST=
EMAIL_PORT=
EMAIL_USER=
EMAIL_PASS=

NODE_ENV=development
