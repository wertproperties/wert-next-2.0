# ----- Frontend environment variables (Create React App) -----
# CRA bakes REACT_APP_* variables in at BUILD time, so this must be set in
# Vercel BEFORE building, then redeploy. Locally you usually don't need it:
# the "proxy" in package.json forwards /api calls to localhost:5000 in dev.

# Full URL of your deployed backend, INCLUDING /api
REACT_APP_API_URL=https://your-backend-url/api
